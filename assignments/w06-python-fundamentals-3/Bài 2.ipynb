    "tong = a + b\n",
    "hieu = a - b\n",
    "tich = a * b\n",
    "thuong = a / b\n",
    "\n",
    "print(f\"Tổng 2 số: {tong}\")\n",
    "print(f\"Hiệu 2 số: {hieu}\")\n",
    "print(f\"Tích 2 số: {tich}\")\n",
    "print(f\"Thương 2 số: {thuong}\")"
